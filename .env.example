NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Preferred provider: Google Gemini (free tier available for eligible models/usage)
GEMINI_API_KEY=

# Optional fallback if you want to use OpenAI instead
OPENAI_API_KEY=

# Optional overrides. Leave blank to use provider defaults.
AI_BASE_URL=
AI_MODEL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only waitlist protection (never expose the service role key with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Generate a long random secret (at least 32 characters) for signed HttpOnly membership cookies and rate-limit key hashing.
WAITLIST_COOKIE_SECRET=
# Resend transactional email API; use a sender address on a domain verified with Resend.
RESEND_API_KEY=
WAITLIST_EMAIL_FROM=
